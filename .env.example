# Local development env vars. Copy this file to `.env` (which is gitignored)
# and fill in real values. Then either:
#   - export DB_PASSWORD=xxx  before running mvn spring-boot:run
#   - or use a tool that loads .env automatically (e.g. dotenv-cli,
#     IntelliJ's EnvFile plugin, or docker-compose)
#
# Spring Boot reads these via ${DB_PASSWORD:default} placeholders in
# backend/src/main/resources/application.yml.

DB_PASSWORD=your_mysql_password_here
